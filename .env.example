# Public origin, no trailing slash. Use your HTTPS domain in production.
PUBLIC_BASE_URL=http://localhost:5173
# Production server origin: set to the same value as PUBLIC_BASE_URL.
ORIGIN=http://localhost:5173

# Linear OAuth application credentials; redirect URI: PUBLIC_BASE_URL/callback
PUBLIC_CLIENT_ID=
CLIENT_TOKEN=
LABEL_NAME=needline

# Customer sign-in bridge (see docs/user-auth.md)
AUTH_URL=
# PEM public key; use a quoted multiline value in .env
JWT_ENCRYPTION_PUBLIC_KEY=

# Generated by `bun run setup`. Keep these stable across deployments.
COOKIE_ENCRYPTION_KEY=
STORE_FILE_ENCRYPTION_KEY=

# Persistent, writable directory for encrypted tokens and settings
DATA_DIR=./data
